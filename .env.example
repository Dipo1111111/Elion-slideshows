# ── Server (Express) ──────────────────────────────────────────────
PORT=8787
APP_URL=http://localhost:5173

# ── Supabase (auth + database + storage) ──────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy HS256 fast-path only. Supabase may sign access tokens
# with ECC (ES256) after JWT key migration; the server verifies via
# Supabase's /auth/v1/user regardless, so this can stay blank.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=backgrounds
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI generation (OpenCode Zen; replaces OpenRouter) ─────────────
OPENCODE_API_KEY=
# big-pickle = the free model on OpenCode Zen (locked 2026-08-05). Others: glm-5, glm-5.1, glm-5.2
OPENCODE_MODEL=
# OpenCode Zen base URL (default: https://opencode.ai/zen/v1)
OPENCODE_BASE_URL=

# ── Image library (Apify Pinterest pull) ──────────────────────────
APIFY_API_KEY=
APIFY_ACTOR_ID=fatihtahta/pinterest-scraper-search

# ── Billing (Lemon Squeezy) ───────────────────────────────────────
# Creator $19/mo + $190/yr; Studio $49/mo + $490/yr.
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_URL=
LEMON_SQUEEZY_VARIANT_ID=
LEMON_SQUEEZY_VARIANT_ID_ANNUAL=
LEMON_SQUEEZY_VARIANT_ID_STUDIO=
LEMON_SQUEEZY_VARIANT_ID_STUDIO_ANNUAL=

BRAND_NAME=Elion
